# Copy to .env.local for local development. Never commit real values.
# Every value below is server-only. Do not add a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_GLOBAL_DAILY_LIMIT=250
RATE_LIMIT_SALT=

# Required in production for durable chat, recommendations, analytics, and rate limits.
DATABASE_URL=

# Discord delivery and reply command.
DISCORD_WEBHOOK_URL=
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_OWNER_USER_ID=

# Recommendation invite signing and approval API.
ATTESTATION_SIGNING_SECRET=
ADMIN_API_TOKEN=

# Public URL used when generating recommendation invitation links.
PUBLIC_SITE_URL=http://127.0.0.1:5173
